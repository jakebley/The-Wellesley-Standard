---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = (await getCollection('living-here')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout title="Living Here" description="General Wellesley lifestyle and town coverage from 1881.">
  <header class="page-header">
    <p class="page-header__kicker">Living Here</p>
    <h1>Living Here</h1>
    <p class="page-header__dek">The everyday texture of Wellesley — town life, town meeting, and everything between.</p>
  </header>

  <ul class="article-list">
    {
      entries.map((entry, i) => (
        <li>
          <a href={`/living-here/${entry.id}`}>
            {entry.data.heroImage && (
              <img src={entry.data.heroImage} alt={entry.data.heroAlt ?? ''} loading={i === 0 ? 'eager' : 'lazy'} />
            )}
            <div>
              <h2>{entry.data.title}</h2>
              <p>{entry.data.dek}</p>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .page-header {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-5) var(--space-3) var(--space-4);
  }

  .page-header__kicker {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 var(--space-1);
  }

  .page-header h1 {
    font-size: var(--text-2xl);
  }

  .page-header__dek {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    max-width: 60ch;
  }

  .article-list {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--space-3) var(--space-6);
    list-style: none;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  }

  .article-list a {
    display: block;
    text-decoration: none;
    color: var(--color-ink);
  }

  .article-list img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    margin-bottom: var(--space-2);
  }

  .article-list h2 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-1);
  }

  .article-list p {
    font-family: var(--font-body);
  }
</style>
