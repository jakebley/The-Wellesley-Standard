---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { toIcsDataUri } from '../../lib/ics';

const events = (await getCollection('events'))
  .filter((e) => e.data.startDate >= new Date(new Date().setHours(0, 0, 0, 0)))
  .sort((a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf());

const dateFormatter = new Intl.DateTimeFormat('en-US', { weekday: 'long', month: 'long', day: 'numeric' });
const timeFormatter = new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit' });
---

<BaseLayout title="Events" description="What's going on in Wellesley this week — with one-click add to calendar.">
  <header class="page-header">
    <p class="page-header__kicker">Events</p>
    <h1>What's Going On</h1>
    <p class="page-header__dek">A running list of Wellesley events, sourced from the town, the library, and local organizations.</p>
  </header>

  <ul class="event-list">
    {
      events.map((event) => {
        const icsHref = toIcsDataUri({
          uid: `${event.id}@1881wellesley.com`,
          title: event.data.title,
          description: event.data.description,
          location: event.data.location,
          start: event.data.startDate,
          end: event.data.endDate,
        });
        return (
          <li>
            <div class="event-list__date">
              <span class="event-list__day">{dateFormatter.format(event.data.startDate)}</span>
              <span class="event-list__time">{timeFormatter.format(event.data.startDate)}</span>
            </div>
            <div class="event-list__body">
              <h2>{event.data.title}</h2>
              <p class="event-list__location">{event.data.location}</p>
              <p class="event-list__description">{event.data.description}</p>
              {event.data.sourceName && (
                <p class="event-list__source">
                  Source:{' '}
                  {event.data.sourceUrl ? (
                    <a href={event.data.sourceUrl}>{event.data.sourceName}</a>
                  ) : (
                    event.data.sourceName
                  )}
                </p>
              )}
            </div>
            <a class="event-list__ics" href={icsHref} download={`${event.id}.ics`}>
              + Add to Calendar
            </a>
          </li>
        );
      })
    }
  </ul>
</BaseLayout>

<style>
  .page-header {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-5) var(--space-3) var(--space-4);
  }

  .page-header__kicker {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 var(--space-1);
  }

  .page-header h1 {
    font-size: var(--text-2xl);
  }

  .page-header__dek {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    max-width: 60ch;
  }

  .event-list {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--space-3) var(--space-6);
    list-style: none;
    border-top: 1px solid var(--color-hairline);
  }

  .event-list li {
    display: grid;
    grid-template-columns: 9rem 1fr auto;
    gap: var(--space-3);
    align-items: start;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-hairline);
  }

  @media (max-width: 40rem) {
    .event-list li {
      grid-template-columns: 1fr;
    }
  }

  .event-list__date {
    display: flex;
    flex-direction: column;
    font-family: var(--font-sans);
  }

  .event-list__day {
    font-weight: 600;
    color: var(--color-accent);
    font-size: var(--text-sm);
  }

  .event-list__time {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }

  .event-list__body h2 {
    font-size: var(--text-lg);
    margin-bottom: 0.25rem;
  }

  .event-list__location {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    margin: 0 0 var(--space-1);
  }

  .event-list__description {
    font-family: var(--font-body);
    margin: 0 0 var(--space-1);
  }

  .event-list__source {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    margin: 0;
  }

  .event-list__source a {
    color: var(--color-ink-muted);
  }

  .event-list__ics {
    justify-self: start;
    white-space: nowrap;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    color: var(--color-ink);
    border: 1px solid var(--color-ink);
    padding: 0.4rem 0.9rem;
    transition:
      background-color 0.2s var(--ease-out-expo),
      color 0.2s var(--ease-out-expo);
  }

  .event-list__ics:hover {
    background: var(--color-ink);
    color: var(--color-paper);
  }
</style>
