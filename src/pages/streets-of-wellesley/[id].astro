---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('streets-of-wellesley');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
---

<BaseLayout
  title={entry.data.title}
  description={`Streets of Wellesley: ${entry.data.neighborhood}`}
  image={entry.data.photos[0].image}
>
  <article class="street">
    <header class="street__header">
      <p class="street__kicker">Streets of Wellesley</p>
      <h1>{entry.data.title}</h1>
      <p class="street__neighborhood">{entry.data.neighborhood}</p>
    </header>

    <div class="street__photos">
      {
        entry.data.photos.map((photo, i) => (
          <img src={photo.image} alt={photo.alt} loading={i === 0 ? 'eager' : 'lazy'} />
        ))
      }
    </div>
  </article>
</BaseLayout>

<style>
  .street__header {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-5) var(--space-3) var(--space-3);
  }

  .street__kicker {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 var(--space-1);
  }

  .street__header h1 {
    font-size: var(--text-2xl);
  }

  .street__neighborhood {
    font-family: var(--font-sans);
    color: var(--color-ink-muted);
  }

  .street__photos {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--space-3) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .street__photos img {
    width: 100%;
    max-height: 44rem;
    object-fit: cover;
  }
</style>
