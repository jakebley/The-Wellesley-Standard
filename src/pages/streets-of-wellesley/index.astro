---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = (await getCollection('streets-of-wellesley')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout
  title="Streets of Wellesley"
  description="A photo series on the curb appeal of Wellesley's neighborhoods — purely visual, no addresses or prices."
>
  <header class="page-header">
    <p class="page-header__kicker">Streets of Wellesley</p>
    <h1>Streets of Wellesley</h1>
    <p class="page-header__dek">Neighborhood curb appeal, one street at a time. No addresses, no prices — just the view.</p>
  </header>

  <ul class="street-list">
    {
      entries.map((entry) => (
        <li>
          <a href={`/streets-of-wellesley/${entry.id}`}>
            <img src={entry.data.photos[0].image} alt={entry.data.photos[0].alt} loading="lazy" />
            <div class="street-list__caption">
              <h2>{entry.data.title}</h2>
              <p>{entry.data.neighborhood}</p>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .page-header {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-5) var(--space-3) var(--space-4);
  }

  .page-header__kicker {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 var(--space-1);
  }

  .page-header h1 {
    font-size: var(--text-2xl);
  }

  .page-header__dek {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    max-width: 60ch;
  }

  .street-list {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--space-3) var(--space-6);
    list-style: none;
    display: grid;
    gap: var(--space-2);
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  .street-list a {
    position: relative;
    display: block;
    text-decoration: none;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .street-list img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out-expo);
  }

  .street-list a:hover img {
    transform: scale(1.04);
  }

  .street-list__caption {
    position: absolute;
    inset: auto 0 0 0;
    padding: var(--space-2);
    background: linear-gradient(to top, rgb(10 10 10 / 80%), transparent);
    color: var(--color-paper);
  }

  .street-list__caption h2 {
    color: var(--color-paper);
    font-size: var(--text-base);
    margin-bottom: 0.15rem;
  }

  .street-list__caption p {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 0;
    opacity: 0.85;
  }
</style>
