---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';

const [houseEntries, streetEntries, livingEntries, eventEntries] = await Promise.all([
  getCollection('house-of-the-week'),
  getCollection('streets-of-wellesley'),
  getCollection('living-here'),
  getCollection('events'),
]);

const latestHouse = houseEntries.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())[0];
const latestStreet = streetEntries.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())[0];
const latestLiving = livingEntries.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())[0];
const nextEvents = eventEntries
  .filter((e) => e.data.startDate >= new Date())
  .sort((a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf())
  .slice(0, 3);

const eventFormatter = new Intl.DateTimeFormat('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
---

<BaseLayout
  title="Home"
  description="1881 is the Wellesley Standard — an editorial look at the homes, streets, and events that define Wellesley, Massachusetts."
>
  <section class="hero">
    <div class="hero__watermark" aria-hidden="true">1881</div>
    <div class="hero__inner">
      <Logo />
      <h1>The Wellesley Standard</h1>
      <p class="hero__dek">
        An editorial look at the homes, streets, and moments that make Wellesley, Massachusetts feel like home —
        not a listing service, not a blog.
      </p>
    </div>
  </section>

  <section class="pillars">
    {
      latestLiving && (
        <a class="pillar-card" href={`/living-here/${latestLiving.id}`}>
          <p class="pillar-card__kicker">Living Here</p>
          <h2>{latestLiving.data.title}</h2>
          <p class="pillar-card__dek">{latestLiving.data.dek}</p>
        </a>
      )
    }

    {
      latestHouse && (
        <a class="pillar-card pillar-card--image" href={`/house-of-the-week/${latestHouse.id}`}>
          <img src={latestHouse.data.heroImage} alt={latestHouse.data.heroAlt} loading="eager" />
          <div class="pillar-card__overlay">
            <p class="pillar-card__kicker">House of the Week</p>
            <h2>{latestHouse.data.title}</h2>
          </div>
        </a>
      )
    }

    {
      latestStreet && (
        <a class="pillar-card pillar-card--image" href={`/streets-of-wellesley/${latestStreet.id}`}>
          <img src={latestStreet.data.photos[0].image} alt={latestStreet.data.photos[0].alt} loading="eager" />
          <div class="pillar-card__overlay">
            <p class="pillar-card__kicker">Streets of Wellesley</p>
            <h2>{latestStreet.data.title}</h2>
          </div>
        </a>
      )
    }
  </section>

  <section class="events-teaser">
    <div class="events-teaser__header">
      <h2>Coming Up</h2>
      <a href="/events">See all events &rarr;</a>
    </div>
    <ul class="events-teaser__list">
      {
        nextEvents.map((event) => (
          <li>
            <time datetime={event.data.startDate.toISOString()}>{eventFormatter.format(event.data.startDate)}</time>
            <span>{event.data.title}</span>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: var(--space-5) var(--space-3) var(--space-6);
    border-bottom: 1px solid var(--color-hairline);
  }

  .hero__watermark {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: min(40vw, 32rem);
    line-height: 1;
    color: var(--color-ink);
    opacity: 0.035;
    pointer-events: none;
    user-select: none;
  }

  .hero__inner {
    position: relative;
    max-width: var(--page-max);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  @keyframes hero-reveal {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero__inner > :global(*) {
    animation: hero-reveal 0.7s var(--ease-out-expo) backwards;
  }

  .hero__inner > :global(*:nth-child(1)) {
    animation-delay: 0s;
  }

  .hero__inner > :global(*:nth-child(2)) {
    animation-delay: 0.1s;
  }

  .hero__inner > :global(*:nth-child(3)) {
    animation-delay: 0.2s;
  }

  .hero__watermark {
    animation: hero-fade 1.2s var(--ease-out-expo) backwards;
    animation-delay: 0.05s;
  }

  @keyframes hero-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 0.035;
    }
  }

  .hero h1 {
    font-size: var(--text-3xl);
    max-width: 16ch;
  }

  .hero__dek {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    max-width: 50ch;
    color: var(--color-ink);
  }

  .pillars {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-5) var(--space-3);
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  .pillar-card {
    display: block;
    text-decoration: none;
    color: var(--color-ink);
    border: 1px solid var(--color-hairline);
    padding: var(--space-3);
    transition: border-color 0.3s var(--ease-out-expo);
  }

  .pillar-card:hover {
    border-color: var(--color-accent);
  }

  .pillar-card--image {
    position: relative;
    padding: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .pillar-card--image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out-expo);
  }

  .pillar-card--image:hover img {
    transform: scale(1.04);
  }

  .pillar-card__overlay {
    position: absolute;
    inset: auto 0 0 0;
    padding: var(--space-3);
    background: linear-gradient(to top, rgb(10 10 10 / 85%), transparent);
    color: var(--color-paper);
  }

  .pillar-card__overlay h2 {
    color: var(--color-paper);
  }

  .pillar-card__kicker {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 var(--space-1);
  }

  .pillar-card--image .pillar-card__kicker {
    color: #ffb3b3;
  }

  .pillar-card h2 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-1);
  }

  .pillar-card__dek {
    font-family: var(--font-body);
    font-size: var(--text-base);
    margin: 0;
  }

  .events-teaser {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--space-3) var(--space-6);
  }

  .events-teaser__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-2);
  }

  .events-teaser__header a {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    text-decoration: none;
    color: var(--color-accent);
  }

  .events-teaser__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-hairline);
  }

  .events-teaser__list li {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-hairline);
    font-family: var(--font-body);
  }

  .events-teaser__list time {
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--color-accent);
    min-width: 7ch;
  }
</style>
